{
  "name": "jansetu-vortexa",
  "version": "1.0.0",
  "private": true,
  "description": "India Development Intelligence Platform (JanSetu)",
  "scripts": {
    "install:client": "npm --prefix client install --include=dev",
    "install:server": "npm --prefix server install",
    "install:all": "npm --prefix client install --include=dev && npm --prefix server install",
    "build:client": "npm --prefix client run build",
    "build": "npm --prefix client install --include=dev && npm --prefix client run build && npm --prefix server install",
    "start": "node server/server.js",
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev",
    "seed": "npm --prefix server run seed"
  },
  "keywords": [
    "jansetu",
    "civic-tech",
    "gemini",
    "render"
  ],
